# FoundU partner API (Australian tenant origin only).
# Infinity Ben must grant partner API access before live reads succeed.
# Steadfast owns credential rotation. Leave the token empty in source control.
FOUNDU_BASE_URL=https://tenant.foundu.com.au
FOUNDU_API_TOKEN=

# Server configuration
MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
NODE_ENV=development

# Optional. When set, HTTP /mcp requires a gateway X-Gateway-S2S header.
# CONDUIT_S2S_SECRET=
