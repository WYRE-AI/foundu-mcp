# foundU MCP environment.
# The upstream host is fixed at https://api.foundu.com.au; there is no base URL
# setting. The tenant is implied by the access token.

# foundU OAuth2 access token (stdio, and HTTP only when AUTH_MODE=env).
# Short-lived. This server never refreshes it: foundU refresh tokens are
# one-time use, and a second refresher would kill the integration. In
# gateway mode this is ignored; the gateway sends a fresh token per request on
# X-FoundU-Access-Token. Leave empty in source control.
FOUNDU_ACCESS_TOKEN=

# Tool tiers to expose. Every tool is read-only. read is the default surface;
# admin adds the labour-management and timesheet-analysis reports, which
# return per-employee pay figures (use read,admin to enable them).
# In HTTP mode Conduit may send X-Conduit-Tool-Tiers to narrow (never widen)
# this set per request; an empty header exposes no tools.
# FOUNDU_TOOL_TIERS=read

# stdio (default) or http
# MCP_TRANSPORT=stdio

# Bind address for MCP_TRANSPORT=http. Defaults to 127.0.0.1. The container
# image sets 0.0.0.0 and requires CONDUIT_S2S_SECRET.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080

# Optional Host-header allowlist for /mcp (comma-separated, case-insensitive,
# with or without port). Requests with any other Host get 403. Unset = no check.
# MCP_ALLOWED_HOSTS=foundu-mcp.internal,localhost

# Required to start the HTTP transport. Leave empty here; never commit a value.
# Generate with: openssl rand -hex 32
# Startup refuses secrets shorter than 32 characters, known placeholders, and
# repeated patterns. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Exactly 1 starts HTTP without CONDUIT_S2S_SECRET,
# skips the X-Gateway-S2S check, and binds 127.0.0.1 regardless of
# MCP_HTTP_HOST. A placeholder secret is still refused.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (FOUNDU_ACCESS_TOKEN above) or gateway
# (X-FoundU-Access-Token on every request; no env fallback). The container
# image sets gateway. stdio reads FOUNDU_ACCESS_TOKEN unless AUTH_MODE=gateway.
# AUTH_MODE=env

# foundU publishes no rate limits. Upstream calls are capped per access token
# (per tenant) and 429/503 are retried at most twice (never waiting more than
# 5s, and without holding a permit while waiting).
# FOUNDU_MAX_CONCURRENCY=4
# FOUNDU_RETRY_BASE_MS=500

# Deadline for one whole call: waiting for a permit, every attempt, and backoff.
# FOUNDU_REQUEST_TIMEOUT_MS=30000
# FOUNDU_MAX_RESPONSE_CHARS=60000
# FOUNDU_MAX_UPSTREAM_BYTES=4194304
# LOG_LEVEL=info
